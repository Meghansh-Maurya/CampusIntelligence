# Local development configuration. Copy this file to .env and edit your values.
APP_NAME="Campus Intelligence & Placement Assistant API"
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
AUTO_CREATE_TABLES=true

# PostgreSQL. The DB_NAME below matches the database name used in this learning project.
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Campus_Intelligence
# Optionally set DATABASE_URL instead of the five DB_* values. Leave unset for the defaults above.

# DEVELOPMENT ONLY: allows X-Dev-User-Id headers while DEBUG=true.
# For deployment use AUTH_MODE=firebase and DEBUG=false.
AUTH_MODE=development
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini AI. Add a real API key to enable RAG generation, embeddings, resume analysis,
# syllabus-topic extraction, and AI mock interviews. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=300
MAX_DOCUMENT_CHUNKS_FOR_RETRIEVAL=600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
