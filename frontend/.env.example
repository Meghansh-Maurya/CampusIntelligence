# Public frontend API URL. Never put secret API keys in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Firebase web app configuration can be added when we implement frontend auth.
# Values prefixed with VITE_ are bundled into browser code and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
